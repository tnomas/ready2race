# DEV only: CORS, the e-mail debug view /api/dev/emails and stack traces in 500 responses.
# STAGING behaves like PROD in these respects (stack traces are also returned in TEST).
MODE={DEV | STAGING | PROD | TEST}

HTTP_HOST={host}
HTTP_PORT={port}

DATABASE_URL=jdbc:postgresql://{host}:{port}/{db}
DATABASE_USER={user}
DATABASE_PASSWORD={password}
DATABASE_LOG_QUERIES={true | false} # optional, defaults to false
# Size of the connection pool (scheduler jobs and requests share it).
DATABASE_POOL_SIZE={size} # optional, defaults to 10
# Upper limit per SQL statement in milliseconds; 0 disables it. Does not apply to migrations at startup.
DATABASE_STATEMENT_TIMEOUT_MS={ms} # optional, defaults to 120000 (2 minutes)

SMTP_HOST={host}
SMTP_PORT={port}
SMTP_USER={user}
SMTP_PASSWORD={password}
SMTP_STRATEGY={SMTP | SMTPS | SMTP_TLS | SMTP_OAUTH2}
SMTP_FROM_ADDRESS={email}
SMTP_LOCALHOST={host} # optional
SMTP_FROM_NAME={name} # optional
SMTP_REPLY={email} # optional

ADMIN_EMAIL={e-mail}
ADMIN_PASSWORD={password}

SECURITY_PEPPER={pepper}
# Memory of new Argon2id password hashes in KiB (2 iterations, 1 lane). Older hashes keep their own
# parameters, still verify and are re-hashed with the current value on the next successful login.
SECURITY_ARGON2_MEMORY_KIB={kib} # optional, defaults to 19456 (19 MiB), minimum 8

# Origin(s) the frontend is served from, comma separated, e.g. https://regatta.example.org
# Links in e-mails (password reset, invitation, registration, challenge access) may only point there.
# optional; if unset, the link host must equal the Host header of the request (DEV/TEST also allow localhost).
# Set it in production - the fallback trusts the Host header that a client can choose freely.
FRONTEND_ORIGINS={origins} # optional, e.g. https://regatta.example.org,http://localhost:5123

# Time zone of the app: wall clock for schedules, start times, expiry times and every timestamp column.
# optional; defaults to Europe/Berlin - deliberately NOT the host's zone (containers often run in UTC).
APP_TIMEZONE={zone} # optional, e.g. Europe/Berlin

STATIC_FILES_PATH={path} # Path to static files directory (e.g., /path/to/backend/static)

# When one WebDAV config is defined, follwing WebDAV configs need to be defined: WEBDAV_URL_SCHEME, WEBDAV_HOST, WEBDAV_AUTH_USER, WEBDAV_AUTH_PASSWORD
WEBDAV_URL_SCHEME={urlScheme} # optional, define all webdav fields or none
WEBDAV_HOST={host} # optional, define all webdav fields or none
WEBDAV_PATH={path} # optional
WEBDAV_FOLDER_PATH={folderPath} # optional
WEBDAV_AUTH_USER={user} # optional, define all webdav fields or none
WEBDAV_AUTH_PASSWORD={password} # optional, define all webdav fields or none
# NEXTCLOUD puts files under remote.php/dav/files/<user> (Nextcloud, ownCloud).
# PLAIN treats the share root as the root (pCloud: ewebdav.pcloud.com for EU accounts, webdav.pcloud.com for US).
# WEBDAV_FOLDER_PATH must already exist on the server - the export only creates its own subfolders.
WEBDAV_LAYOUT={NEXTCLOUD | PLAIN} # optional, defaults to NEXTCLOUD

WHITELIST_EMAIL_RECEIVER="[regexes]" # optional, define whitelisted email regexes or none (no whitelist - all allowed)