# Kopie als .env ablegen und ausfüllen. Die Datei gehört nicht in die Historie.
#
# Werte in Anführungszeichen nur dort, wo sie unten schon stehen.

# --- Verbund ------------------------------------------------------------------

# Port, unter dem der Reverse-Proxy des Hosters die Anwendung erreicht (nur HTTP).
R2R_PORT=8090

# Passwort der mitgelieferten PostgreSQL-Datenbank. Beim ersten Start wird es
# gesetzt, danach ändert es sich über diese Datei NICHT mehr.
POSTGRES_PASSWORD=

# PROD blendet Entwicklerpfade aus und verzichtet auf CORS. STAGING für einen
# Testserver.
MODE=PROD

TZ=Europe/Berlin

# Fertige Images statt lokalem Bau: Präfix der Registry mit Schrägstrich am
# Ende, dann `docker compose pull && docker compose up -d --no-build`.
#R2R_IMAGE_PREFIX=ghcr.io/tnomas/
#R2R_IMAGE_TAG=latest

# --- Anwendung ----------------------------------------------------------------

# Wird beim ersten Start als Administrator angelegt.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Geheimer Zusatz für Passwort-Hashes, z. B. `openssl rand -hex 32`.
# Nach dem ersten Start NIE mehr ändern, sonst passt kein Passwort mehr.
SECURITY_PEPPER=

# Mailversand ist Pflicht: Einladungen, Registrierung und Rechnungen laufen
# darüber. Ohne erreichbaren Server startet die Anwendung trotzdem, die Mails
# bleiben dann in der Warteschlange liegen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP | SMTPS | SMTP_TLS | SMTP_OAUTH2
SMTP_STRATEGY=SMTP_TLS
SMTP_FROM_ADDRESS=
#SMTP_FROM_NAME=Ready2Race
#SMTP_REPLY=
#SMTP_LOCALHOST=

# Nur an Adressen senden, die auf eines der Muster passen (JSON-Liste mit
# regulären Ausdrücken). Praktisch auf Testservern. Ohne Angabe: alle erlaubt.
#WHITELIST_EMAIL_RECEIVER="[\".*@example\\.org\"]"

# Nur nötig, wenn das Backend beim Start SQL-Abfragen ins Log schreiben soll.
#DATABASE_LOG_QUERIES=false

# --- WebDAV-Export (optional) -------------------------------------------------
# Entweder alle vier Pflichtfelder oder keins.
#WEBDAV_URL_SCHEME=https
#WEBDAV_HOST=cloud.example.org
#WEBDAV_PATH=
#WEBDAV_FOLDER_PATH=Ready2Race
#WEBDAV_AUTH_USER=
#WEBDAV_AUTH_PASSWORD=
# NEXTCLOUD (auch ownCloud) oder PLAIN (pCloud und die meisten schlichten Server)
#WEBDAV_LAYOUT=NEXTCLOUD
