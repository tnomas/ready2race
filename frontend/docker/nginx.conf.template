# Vorlage: ${BACKEND_UPSTREAM} wird beim Containerstart eingesetzt, alle
# anderen $-Variablen bleiben nginx-Variablen.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Weiterleitungen relativ ausgeben: nginx kennt nur seinen Container-Port 80,
    # nicht R2R_PORT oder die Adresse des äußeren Proxys.
    absolute_redirect off;

    # nginx kennt die Endung des Web-App-Manifests nicht und würde es als
    # Binärdatei ausliefern; der Browser lehnt es dann ab.
    include /etc/nginx/mime.types;
    types {
        application/manifest+json webmanifest;
    }

    # Uploads (Schriften, Logos, Dokumentvorlagen, Importe)
    client_max_body_size 50m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               application/manifest+json image/svg+xml font/woff2;

    # Der Docker-DNS löst den Backend-Namen bei jedem Verbindungsaufbau neu auf.
    # Mit einer Variable im proxy_pass übersteht nginx so einen Neustart des
    # Backend-Containers, der eine andere Adresse bekommt.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://${BACKEND_UPSTREAM};

    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Websockets der Zeitnahme, Boards und Livestream-Szenen
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /static/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Gebaute Bundles tragen einen Hash im Namen und dürfen ewig im Cache liegen.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Service Worker und Manifest der Helfer-App müssen frisch bleiben, sonst
    # hängt eine installierte App auf einem alten Stand fest.
    location = /app/sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    location = /app/manifest.webmanifest {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    # Single-Page-App: unbekannte Pfade landen bei der index.html. Kein `$uri/`:
    # /app/ ist ein Verzeichnis (Icons, Manifest, Service Worker) ohne eigene
    # index.html und ergäbe sonst 403 - genau die Startadresse der Helfer-App.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
